{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Vite bundles the app: bundler resolution, DOM types and JSX; tsc writes only declarations, to out-tsc.
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["es2022", "dom"],
    "outDir": "out-tsc"
  },
  "include": ["src", "vite.config.mts", "screenshot.script.ts"],
  "references": [
    {
      "path": "../../libs/cards"
    }
  ]
}
