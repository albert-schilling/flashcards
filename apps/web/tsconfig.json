{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Vite bundles the app, so it needs bundler resolution, DOM types and JSX, and tsc emits nothing.
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["es2022", "dom"],
    "outDir": "out-tsc"
  },
  "include": ["src"]
}
