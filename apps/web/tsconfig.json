{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Vite bundles the app: bundler resolution, DOM types and JSX; tsc writes only declarations, to out-tsc.
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["es2022", "dom"],
    "outDir": "out-tsc",
    // The screenshot script imports ./src/ui.text.ts with its extension, which Node needs.
    "allowImportingTsExtensions": true,
    // TypeScript checks side-effect imports; vite/client declares the *.css modules main.tsx imports.
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.mts", "screenshot.script.ts"],
  "references": [
    {
      "path": "../../libs/cards"
    }
  ]
}
